Require Import Psatz.
Proof.
intros.
  (* 1. Доказываем сохранение ячеек матрицы A *)
  assert (EqA: forall idx, (0 <= idx)%Z -> (idx < i * i1)%Z -> a13 (shift a idx) = a10 (shift a idx)).
  {
    intros idx Hidx_min Hidx_max. unfold a13, a11, Map.set.
    destruct (why_decidable_eq (shift a2 (i7 + x3)%Z) (shift a idx)) as [Heq | Hneq].
    - unfold shift, base, offset, a4, a5, x1, x2 in *. 
      injection Heq as HeqBase HeqOff.
      (* Используем новую гипотезу H19 *)
      destruct H25 as [Hb1|[Hb2|[Hb3|[Hb4|Hb5]]]].
      * nia.
      * nia.
      * unfold base, shift in Hb3. unfold base in Hb3. congruence.
      * assert (Step: (i7 + i2 * i3 < i1 * i2)%Z) by nia.
        destruct a2 as [b_a2 o_a2]. destruct a as [b_a o_a].
        unfold shift, offset, base in *. simpl in *. nia. 
      * destruct a2 as [b_a2 o_a2]. destruct a as [b_a o_a].
        unfold shift, offset, base in *. simpl in *. nia.
    - reflexivity.
  }

  (* 2. Доказываем сохранение ячеек матрицы B *)
  assert (EqB: forall idx, (0 <= idx)%Z -> (idx < i * i2)%Z -> a13 (shift a1 idx) = a10 (shift a1 idx)).
  {
    intros idx Hidx_min Hidx_max. 
    unfold a13, a11, Map.set.
    destruct (why_decidable_eq (shift a2 (i7 + x3)%Z) (shift a1 idx)) as [Heq | Hneq].
    - unfold shift, base, offset, a3, a5, x, x2, x3 in *. 
      injection Heq as HeqBase HeqOff.
      (* Используем новую гипотезу H18 *)
      destruct H24 as [Hb1|[Hb2|[Hb3|[Hb4|Hb5]]]].
      * nia.
      * nia.
      * assert (Step: (i7 + i2 * i3 < i1 * i2)%Z) by nia.
        destruct a2 as [b_a2 o_a2]. destruct a1 as [b_a o_a].
        unfold shift, offset, base, x3 in *. simpl in *. nia. 
      * assert (Step: (i7 + i2 * i3 < i1 * i2)%Z) by nia.
        destruct a2 as [b_a2 o_a2]. destruct a1 as [b_a1 o_a1].
        simpl in *. nia.
      * destruct a2 as [b_a2 o_a2]. destruct a1 as [b_a1 o_a1].
        simpl in *. nia.
    - reflexivity.
  }

  (* 3. Лемма кадра для скалярного произведения *)
  assert (Hframe_dot: forall k_dot col res_, 
      (k_dot <= i)%Z -> (col < i2)%Z -> (0 <= col)%Z -> 
      P_DotProduction a10 a a1 k_dot i3 i col i2 res_ -> 
      P_DotProduction a13 a a1 k_dot i3 i col i2 res_).
  {
    intros k_dot col res_ Hk_max Hcol_min Hcol_max Hdot_k.
    induction Hdot_k as [to_empty Hempty | to_pos Hpos Hdot_prev IH].
    - apply Q_dotproduction_empty_range. lia.
    - rewrite <- EqA; [ | lia | nia ].
      rewrite <- EqB.
      
      apply Q_dotproduction_positive_range.
      + lia.
      + apply IHHdot_k; try assumption. nia.
      + nia.
      + nia.
  }

  (* 4. Финальное разделение на случаи (i4 < i7 или i4 = i7) *)
  assert (H_cases: (i4 < i7 \/ i4 = i7)%Z) by lia.
  destruct H_cases as [H_lt | H_eq].
  
  - (* СЛУЧАЙ 1: i4 < i7 *)
    assert (EqC: a13 (shift a2 (i4 + x3)%Z) = a10 (shift a2 (i4 + x3)%Z)).
    {
      unfold a13, a11, Map.set.
      destruct (why_decidable_eq (shift a2 (i7 + x3)%Z) (shift a2 (i4 + x3)%Z)) as [Heq | Hneq].
      * unfold shift, offset in Heq. injection Heq. lia. 
      * reflexivity.
    }
    rewrite EqC.
    apply Hframe_dot.
    + lia.
    + nia.
    + nia.
    + apply H35. (* Используем новую гипотезу H35 *)
      * nia.
      * nia.

  - (* СЛУЧАЙ 2: i4 = i7 *)
    rewrite H_eq.
    assert (EqC_new: a13 (shift a2 (i7 + x3)%Z) = a12).
    {
      unfold a13, a11, Map.set.
      destruct (why_decidable_eq (shift a2 (i7 + x3)%Z) (shift a2 (i7 + x3)%Z)) as [Heq | Hneq].
      * reflexivity.
      * congruence. 
    }
    rewrite EqC_new.
    replace i7 with i4 by nia.
    apply Hframe_dot.
    + lia.
    + rewrite H_eq. nia.
    + nia.
    + replace i4 with i7 by nia.
      exact H31. 
Qed.

